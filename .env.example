# Rex environment reference
#
# Backend:
#   cp backend/.env.example backend/.env
#   Fill these values in backend/.env.
#
# Flutter:
#   Pass REX_BACKEND_URL with --dart-define when running/building the app.

# Flutter app setting. This is not read from a .env file by Flutter.
REX_BACKEND_URL=http://localhost:8000

# Backend Grok settings.
APP_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GROK_API_KEY=
GROK_MODEL=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=120

# Backend Supabase settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_LONG_TERM_MEMORY_TABLE=long_term_memory
