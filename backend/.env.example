# Grok API settings. Required for real chat.
APP_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GROK_API_KEY=
GROK_MODEL=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=120

# Supabase settings. Required for conversations, messages, and memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_LONG_TERM_MEMORY_TABLE=long_term_memory
